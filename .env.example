# Copy to .env (in this folder, or to ~/.anexis/.env) and fill in what you have.
# Everything is optional. Never commit the real file.

# ---- models ---------------------------------------------------------------
# Ollama needs no key. For Nvidia, get a key at build.nvidia.com and paste it:
NVIDIA_API_KEY=

# Ollama's hosted models (not needed for Ollama on this computer):
OLLAMA_API_KEY=

# ---- school ---------------------------------------------------------------
# Canvas: missing and upcoming assignments, reminders, slides from any class.
# The address is the one in your browser when you open Canvas. The token is
# made in Canvas under Account, Settings, New Access Token.
CANVAS_URL=
CANVAS_TOKEN=

# ---- code creation --------------------------------------------------------
# Claude Code uses this key when it writes code for you. Leave it empty if you
# have a Claude plan (Pro or Max): sign in once with `claude auth login`, or
# from the Keys screen in the app, and it codes on that plan.
ANTHROPIC_API_KEY=

# ---- reaching Anexis from another machine -----------------------------------
# On the server: set a long random token and ANEXIS_HOST=0.0.0.0
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# On your laptop: set the same token and ANEXIS_URL=http://your-server:8765
ANEXIS_TOKEN=
# ANEXIS_HOST=127.0.0.1
# ANEXIS_PORT=8765
# ANEXIS_URL=

# ---- tools that turn on when their key is here ----------------------------
GITHUB_TOKEN=
NOTION_TOKEN=
BRAVE_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=
