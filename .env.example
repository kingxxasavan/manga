# Copy to .env.local for local work. On Vercel, add these under
# Project > Settings > Environment Variables. Never commit real values.

# Postgres connection string. Adding a Postgres database (for example Neon)
# from the Vercel Storage tab sets this for you.
DATABASE_URL=

# Stripe secret key. Use a test key (sk_test_...) until you are ready to charge real cards.
STRIPE_SECRET_KEY=

# Signing secret of the Stripe webhook that points at /api/stripe/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=

# Password for /admin. At least 12 characters. Use a long random one.
ADMIN_PASSWORD=

# Optional. Public address of the site, no trailing slash, e.g. https://example.com
SITE_URL=

# Optional. Shown on order pages and the policies page.
NEXT_PUBLIC_SUPPORT_EMAIL=
