# Copy to .env (in this folder, or to ~/.greg/.env) and fill in what you have.
# Everything is optional. Never commit the real file.

# ---- models ---------------------------------------------------------------
# Ollama needs no key. For Nvidia, get a key at build.nvidia.com and paste it:
NVIDIA_API_KEY=

# ---- code creation --------------------------------------------------------
# Claude Code uses this key when it writes code for you. Leave it empty if you
# logged in by running `claude` on the server instead.
ANTHROPIC_API_KEY=

# ---- reaching Greg from another machine -----------------------------------
# On the server: set a long random token and GREG_HOST=0.0.0.0
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# On your laptop: set the same token and GREG_URL=http://your-server:8765
GREG_TOKEN=
# GREG_HOST=127.0.0.1
# GREG_PORT=8765
# GREG_URL=

# ---- tools that turn on when their key is here ----------------------------
GITHUB_TOKEN=
NOTION_TOKEN=
BRAVE_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=
