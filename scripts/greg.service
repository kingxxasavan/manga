# Keeps Greg running in the background and across reboots, as your own user.
#
#   mkdir -p ~/.config/systemd/user
#   cp scripts/greg.service ~/.config/systemd/user/
#   systemctl --user enable --now greg
#   loginctl enable-linger "$USER"     # keep it running when you log out
#
# Logs: journalctl --user -u greg -f

[Unit]
Description=Greg personal assistant
After=network-online.target

[Service]
ExecStart=%h/.local/bin/greg serve
Restart=on-failure
RestartSec=5
# Ollama and the tool servers are found through your normal PATH.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
